{
  "name": "@justinkahrs/on-device-demo",
  "version": "0.1.0",
  "description": "Reusable React mock mobile chat UI with scripted message playback.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinkahrs/on-device-demo.git"
  },
  "bugs": {
    "url": "https://github.com/justinkahrs/on-device-demo/issues"
  },
  "homepage": "https://github.com/justinkahrs/on-device-demo#readme",
  "keywords": [
    "react",
    "chat",
    "mobile-ui",
    "component-library",
    "mock-device"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "clean:lib": "rm -rf dist",
    "build:lib": "npm run clean:lib && tsc -p tsconfig.lib.json && node scripts/copy-lib-assets.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build:lib && npm run pack:check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.4.6",
    "classnames": "^2.5.1",
    "framer-motion": "^12.4.10",
    "react-markdown": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "next": "15.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5"
  }
}
